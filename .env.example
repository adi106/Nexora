# Copy this file to .env and fill in real values for local development.
# See docker-compose.yml for the containerized equivalents.

DATABASE_URL=postgresql+psycopg://nexora:nexora_dev_password@localhost:5432/nexora
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
RESERVATION_EXPIRY_MINUTES=15

# Comma-separated list of origins allowed to call the API (CORS). Defaults to
# the local Vite dev server; add your deployed frontend's URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables the AI shopping assistant (Phase 12). Leave unset to
# disable it — the endpoint responds with a clear 503 instead of failing.
ANTHROPIC_API_KEY=
